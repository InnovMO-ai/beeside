{
  "name": "@beeside/backend",
  "version": "0.1.0",
  "private": true,
  "description": "beeside First Assessment \u2014 backend API service (Node.js + TypeScript).",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../shared/canonical-fields",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run build --prefix ../shared/canonical-fields",
    "test": "jest --runInBand",
    "pretest:integration": "npm run build --prefix ../shared/canonical-fields",
    "test:integration": "jest --runInBand -c jest.integration.config.js",
    "pretypecheck": "npm run build --prefix ../shared/canonical-fields",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:sync-fields": "tsx src/scripts/sync-field-registry.ts",
    "config:publish-dev": "tsx src/scripts/publish-dev-config.ts",
    "billing:inject-event": "tsx src/scripts/inject-subscription-event.ts"
  },
  "dependencies": {
    "@beeside/canonical-fields": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
