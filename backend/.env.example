# beeside backend — environment variable contract (Phase 1 skeleton)
# Real values are never committed. In dev/staging/production these are injected
# by the secrets manager (Technical Architecture v1.1 FINAL §6, §15) — this file
# only documents the shape each environment must supply.

NODE_ENV=development
PORT=8080

# One canonical PostgreSQL database for the entire beeside project lifecycle
# (Technical Architecture v1.1 FINAL §1 principle 3-4, §13). Populated in Phase 2.
DATABASE_URL=postgres://placeholder:placeholder@localhost:5432/beeside_dev

# Populated when the secrets manager / cloud account is provisioned (see README
# "What Mike must provide before Phase 1").
# SECRETS_MANAGER_REGION=
# LOG_LEVEL=info
