{
  "displayName": "Discovery \u2014 5xx responses",
  "combiner": "OR",
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "conditions": [
    {
      "displayName": "5xx rate above 0.05/s for 5 min",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=monitoring.regex.full_match(\"discovery-(web|backend)\") AND metric.label.response_code_class=\"5xx\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.05,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "documentation": {
    "content": "See deploy/production/RUNBOOK.md (alerts section).",
    "mimeType": "text/markdown"
  }
}
