# Discovery Public v1.0 — PRODUCTION configuration TEMPLATE (names and non-secret values only). Copy to production.env (git-ignored), fill in, run the preflight.
# Secrets are referenced by their Secret Manager NAME (SECRET_*); no secret value ever goes in this file.
PROJECT_ID=
REGION=northamerica-south1
SQL_CONNECTION_NAME=            # project:region:instance of the PRODUCTION Cloud SQL instance
IMAGE_TAG=                      # the commit SHA being released

PUBLIC_BASE_URL=https://beeside.you
PUBLIC_PATH=/discovery
FA4_PUBLIC_PATH=/discovery
APP_BASE_URL=https://beeside.you
ALLOWED_ORIGINS=https://beeside.you
OPS_CONTROL_MODE=reserved       # /ops-control stays blocked until the Discovery administration surface is connected
NODE_ENV=production
TRUST_PROXY_HOPS=               # measured behind the real edge

# build-time (web image)
VITE_BASE_PATH=/discovery/
VITE_DISCOVERY_ONLY=true
VITE_FA4_LAUNCH=true
VITE_FA4_PREMIUM_PURCHASE_URL=  # approved purchase destination (https). Empty = the CTA is not rendered
PREMIUM_PURCHASE_DEFERRED_ACK=  # true = knowingly deploy without the purchase destination (controlled phase only)

# secrets (names)
SECRET_DATABASE_URL=            # runtime role
SECRET_MIGRATION_DATABASE_URL=  # migration/owner role (migration job only)
SECRET_HASH=
SECRET_SMTP_PASSWORD=
SECRET_ACCESS_GATE_CREDENTIALS= # only with ACCESS_GATE_MODE=basic

# legal
FA4_PRIVACY_VERSION=            # external: final Privacy document version
FA4_PRIVACY_URL=https://www.beeside.you/privacy
FA4_TERMS_URL=https://beeside.you/termsandconditions
LEGAL1_CONFIRMED=               # true only when Legal has cleared real prospect data
FA4_PREMIUM_COMMERCIAL_CONTENT_ALLOWED=

# e-mail
FA4_EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@beeside.you
MAIL_FROM=contact@beeside.you
MAIL_REPLY_TO=contact@beeside.you
DEPLOY_WORKER=true
MAIL_DNS_CONFIRMED=

# access — controlled launch first; opening is a deliberate configuration change
LAUNCH_PHASE=controlled         # controlled | open
ACCESS_GATE_MODE=basic          # off | basic | edge
ROBOTS_NOINDEX=true
EDGE_GATE_CONFIRMED=
OPEN_COMMERCIAL_CONFIRMED=
COMPARISON_APPROVED=

# platform confirmations (set true only when actually done)
DB_PROVISIONED_CONFIRMED=
DB_BACKUPS_CONFIRMED=
DB_PITR_CONFIRMED=
EDGE_ROUTING_CONFIRMED=
ORG_POLICY_CONFIRMED=
ALERT_CHANNEL=                  # Cloud Monitoring notification channel id

# CLOSED TEST (Stabilization): e-mail goes ONLY to these recipients. Lists accept «,» «;» or spaces.
# FA4_CLOSED_TEST_EMAIL_DOMAINS: whole domains (default beeside.you when unset; set it EMPTY to open no domain).
# FA4_CLOSED_TEST_EMAIL_ADDRESSES: individual authorized addresses (e.g. the two external reviewers). Exact match only: no aliases, no other address of the domain.
FA4_CLOSED_TEST_EMAIL_ADDRESSES=
