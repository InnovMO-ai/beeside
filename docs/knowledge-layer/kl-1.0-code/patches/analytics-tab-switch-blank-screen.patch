+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import "@testing-library/jest-dom/vitest";
+import { jsonResponse } from "../fa/test-fixtures";
+import { AnalyticsView } from "./AnalyticsView";
+
+const FUNNEL = { anonymous: { entered: 15, started: 9 }, projects: { identity_completed: 3, finish_later: 1, resumed: 1, completed: 2, snapshot_viewed: 2, preview_room_clicked: 1, premium_interest: 0, premium_requested: 0, premium_activated: 0, feedback_submitted: 1 }, rates: { start_rate: 0.6 } };
+const BY_VIEW: Record<string, unknown> = {
+  funnel: FUNNEL,
+  "journey-health": { outcomes: { completed: 2, completionRate: 0.5 }, timing: { medianMinutes: 12 }, resume: { resumed: 1, resumeRate: 0.25 }, extensions: [], lifecycle: { active: 3 } },
+  friction: { dropOffByStep: [], questions: [], steps: [], signals: { notSureAnswers: 0 } },
+  feedback: { responses: 1, completed: 2, responseRate: 0.5, average: 4, distribution: [] },
+  operations: { email: [], jobs: [], integrations: [], rateLimits: [], retention: { purgedInRange: 0, dueForPurge: 0, heldByPendingPremiumRequest: 0, oldestPendingPremiumRequestDays: 0 } },
+};
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+describe("Analytics · cambio de pestaña", () => {
+  it.each([["Journey health", "Outcomes"], ["Friction", "Signals"], ["Operational metrics", "Retention"], ["User feedback", "Distribution"]])(
+    "al pasar de Funnel a %s no se rompe con los datos de la pestaña anterior (pantalla en blanco)",
+    async (label, heading) => {
+      vi.stubGlobal("fetch", vi.fn(async (url: string) => {
+        const view = Object.keys(BY_VIEW).find((v) => url.includes(`/analytics/${v}`) && !url.includes("/comments"));
+        if (url.includes("/comments")) return jsonResponse({ comments: [] });
+        return jsonResponse(BY_VIEW[view as string] ?? {});
+      }));
+      render(<AnalyticsView />);
+      await screen.findByText("Entered (anonymous)");
+      fireEvent.click(screen.getByRole("button", { name: label }));
+      expect(await screen.findByText(heading)).toBeInTheDocument();
+    },
+  );
+
+  it("de User feedback de vuelta a Funnel tampoco se rompe", async () => {
+    vi.stubGlobal("fetch", vi.fn(async (url: string) => (url.includes("/comments") ? jsonResponse({ comments: [] }) : jsonResponse(url.includes("/feedback") ? BY_VIEW.feedback : BY_VIEW.funnel))));
+    render(<AnalyticsView />);
+    await screen.findByText("Entered (anonymous)");
+    fireEvent.click(screen.getByRole("button", { name: "User feedback" }));
+    await screen.findByText("Distribution");
+    fireEvent.click(screen.getByRole("button", { name: "Funnel" }));
+    await waitFor(() => expect(screen.getByText("Entered (anonymous)")).toBeInTheDocument());
+  });
+});
