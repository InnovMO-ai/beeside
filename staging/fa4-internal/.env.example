# Internal staging settings (copy to .env). Use throwaway values: this environment holds TEST data only.
DB_OWNER_PASSWORD=change-me-owner
DB_RUNTIME_PASSWORD=change-me-runtime
# Where testers open it (its own host/port; never www.beeside.you — the API refuses that host in staging mode)
STAGING_BASE_URL=http://localhost:8080
WEB_PORT=8080
# user:password gate in front of everything (share only with the internal testers)
STAGING_BASIC_AUTH=tester:change-me
# at least 32 random characters (keys the rate limiter; never the production secret)
STAGING_HASH_SECRET=change-me-change-me-change-me-change-me
# Visible strip on every screen
STAGING_LABEL=STAGING INTERNO · datos de prueba · no uses datos reales
# Leave empty until the final Privacy document exists (a visibly non-legal TEST page is used meanwhile)
FA4_PRIVACY_VERSION=
FA4_PRIVACY_URL=
