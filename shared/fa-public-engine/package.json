{
  "name": "@beeside/fa-public-engine",
  "version": "1.0.0",
  "private": true,
  "description": "FA Public v1.0 deterministic engine: domain vocabulary, Category -> Service -> Capability catalog model, coverage resolver (coverage_basis, I-26), Your Expansion View builder, Demand Signals and the conditional flow. Pure TypeScript: no I/O, no AI, no legacy Snapshot/radar/scoring logic.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./seed": {
      "types": "./dist/cjs/seed.d.ts",
      "import": "./dist/esm/seed.js",
      "require": "./dist/cjs/seed.js"
    },
    "./testing": {
      "types": "./dist/cjs/testing/journeys.d.ts",
      "import": "./dist/esm/testing/journeys.js",
      "require": "./dist/cjs/testing/journeys.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "typesVersions": {
    "*": {
      "seed": [
        "dist/cjs/seed.d.ts"
      ],
      "testing": [
        "dist/cjs/testing/journeys.d.ts"
      ]
    }
  },
  "sideEffects": false
}
