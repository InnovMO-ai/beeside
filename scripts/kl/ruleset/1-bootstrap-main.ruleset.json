{
  "name": "main · BOOTSTRAP previo a la primera integración de L1 (PROPUESTO, no aplicado)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
